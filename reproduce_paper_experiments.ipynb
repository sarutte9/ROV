    "## 2. Leakage-Reduced Relational Feature Pipeline (Section 4)\n",
    "\n",
    "สกัด 4 คุณลักษณะเชิงความสัมพันธ์ (Relational Features) ภายใต้กระบวนการ **5-Fold Out-Of-Fold (OOF) Target Encoding** เพื่อป้องกัน Information Leakage บนชุดฝึก:\n",
    "1. **$F_{\\text{ind}}$ (Bayesian Smoothed Win Rate):** $\\hat{P}(h) = \\frac{W_h + 5}{N_h + 10} - 0.5$ (Beta prior $\\alpha_0=\\beta_0=5$ เทียบเท่า 10 เกมเสมือน)\n",
    "2. **$F_{\\text{syn}}$ (Pairwise Teammate Synergy):** $S(h_i, h_j) = \\frac{W_{ij} + 2}{N_{ij} + 4} - 0.5$ บน 10 คู่ร่วมทีม ($N_{ij} \\ge 3$)\n",
    "3. **$F_{\\text{ctr}}$ (Bipartite Counter-Picks):** $C(h_b, h_r) = \\frac{W(h_b, h_r) + 2}{N(h_b, h_r) + 4} - 0.5$ บน 25 คู่ข้ามฝั่ง ($N \\ge 3$)\n",
    "4. **$F_{\\text{tier}}$ (Contested Tier Priority):** $T(h) = \\frac{N_h + 1.5 B_h}{N_{\\text{matches}}}$ ให้น้ำหนัก Ban สูงกว่า Pick $1.5\\times$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =====================================================================\n",
    "# Step 2: Feature Engineering Engine with 5-Fold OOF Quarantine\n",
    "# =====================================================================\n",
    "def build_relational_lookup_tables(df_slice):\n",
    "    \"\"\"Construct lookup tables strictly from specified match slice.\"\"\"\n",
    "    h_pick = defaultdict(int); h_win = defaultdict(int); h_ban = defaultdict(int)\n",
    "    syn_tot = defaultdict(int); syn_win = defaultdict(int)\n",
    "    ctr_tot = defaultdict(int); ctr_win = defaultdict(int)\n",
    "\n",
    "    for _, r in df_slice.iterrows():\n",
    "        bw = int(r[\"target_blue_win\"])\n",
    "        bH = sorted([r[c] for c in BLUE_HEROES])\n",
    "        rH = sorted([r[c] for c in RED_HEROES])\n",
    "\n",
    "        # Hero picks & wins\n",
    "        for h in bH: h_pick[h] += 1; h_win[h] += bw\n",
    "        for h in rH: h_pick[h] += 1; h_win[h] += (1 - bw)\n",
    "\n",
    "        # Hero bans\n",
    "        for bc in ALL_BANS:\n",
    "            b = str(r[bc]).strip() if pd.notna(r[bc]) else \"\"\n",
    "            if b: h_ban[b] += 1\n",
    "\n",
    "        # Intra-team synergy (10 pairs per faction)\n",
    "        for h1, h2 in combinations(bH, 2):\n",
    "            k = f\"{h1}+{h2}\"\n",
    "            syn_tot[k] += 1; syn_win[k] += bw\n",
    "        for h1, h2 in combinations(rH, 2):\n",
    "            k = f\"{h1}+{h2}\"\n",
    "            syn_tot[k] += 1; syn_win[k] += (1 - bw)\n",
    "\n",
    "        # Bipartite counter-picks (25 matchups)\n",
    "        for hb in bH:\n",
    "            for hr in rH:\n",
    "                k1 = f\"{hb} vs {hr}\"; k2 = f\"{hr} vs {hb}\"\n",
    "                ctr_tot[k1] += 1; ctr_win[k1] += bw\n",
    "                ctr_tot[k2] += 1; ctr_win[k2] += (1 - bw)\n",
    "\n",
    "    return {\n",
    "        \"pick\": h_pick, \"win\": h_win, \"ban\": h_ban,\n",
    "        \"syn_tot\": syn_tot, \"syn_win\": syn_win,\n",
    "        \"ctr_tot\": ctr_tot, \"ctr_win\": ctr_win,\n",
    "        \"n_matches\": len(df_slice)\n",
    "    }\n",
    "\n",
    "def extract_match_relational_features(row, tables):\n",
    "    \"\"\"Extract F_ind, F_syn, F_ctr, F_tier for a single match row using frozen tables.\"\"\"\n",
    "    bH = sorted([row[c] for c in BLUE_HEROES])\n",
    "    rH = sorted([row[c] for c in RED_HEROES])\n",
    "    n_tr = max(1.0, float(tables[\"n_matches\"]))\n",
    "\n",
    "    # 1. F_ind: Beta-Binomial smoothed win rate (alpha_0 = beta_0 = 5)\n",
    "    def hero_wr(h):\n",
    "        n = tables[\"pick\"].get(h, 0); w = tables[\"win\"].get(h, 0)\n",
    "        return (w + 5.0) / (n + 10.0) - 0.5\n",
    "    f_ind = sum(hero_wr(h) for h in bH) - sum(hero_wr(h) for h in rH)\n",
    "\n",
    "    # 2. F_syn: Intra-team teammate synergy (N >= 3)\n",
    "    def team_syn(team):\n",
    "        s = 0.0\n",
    "        for h1, h2 in combinations(team, 2):\n",
    "            k = f\"{h1}+{h2}\"\n",
    "            n_ij = tables[\"syn_tot\"].get(k, 0)\n",
    "            if n_ij >= 3:\n",
    "                s += (tables[\"syn_win\"].get(k, 0) + 2.0) / (n_ij + 4.0) - 0.5\n",
    "        return s\n",
    "    f_syn = team_syn(bH) - team_syn(rH)\n",
    "\n",
    "    # 3. F_ctr: Bipartite head-to-head counter-picks (N >= 3)\n",
    "    f_ctr = 0.0\n",
    "    for hb in bH:\n",
    "        for hr in rH:\n",
    "            k1 = f\"{hb} vs {hr}\"; k2 = f\"{hr} vs {hb}\"\n",
    "            n1 = tables[\"ctr_tot\"].get(k1, 0); n2 = tables[\"ctr_tot\"].get(k2, 0)\n",
    "            c_b = (tables[\"ctr_win\"].get(k1, 0) + 2.0) / (n1 + 4.0) - 0.5 if n1 >= 3 else 0.0\n",
    "            c_r = (tables[\"ctr_win\"].get(k2, 0) + 2.0) / (n2 + 4.0) - 0.5 if n2 >= 3 else 0.0\n",
    "            f_ctr += (c_b - c_r)\n",
    "\n",
    "    # 4. F_tier: Contested Tier Priority (1.5x ban weight)\n",
    "    def hero_tier(h):\n",
    "        pk = tables[\"pick\"].get(h, 0); bn = tables[\"ban\"].get(h, 0)\n",
    "        return (pk + 1.5 * bn) / n_tr\n",
    "    f_tier = sum(hero_tier(h) for h in bH) - sum(hero_tier(h) for h in rH)\n",
    "\n",
    "    return np.array([f_ind, f_syn, f_ctr, f_tier], dtype=np.float64)\n",
    "\n",
    "# One-hot sparse vector representation for 127 heroes\n",
    "hero_to_idx = {h: i for i, h in enumerate(unique_heroes)}\n",
    "def extract_onehot_vector(row):\n",
    "    vec = np.zeros(len(unique_heroes), dtype=np.float64)\n",
    "    for c in BLUE_HEROES: vec[hero_to_idx[row[c]]] = 1.0\n",
    "    for c in RED_HEROES:  vec[hero_to_idx[row[c]]] = -1.0\n",
    "    return vec\n",
    "\n",
    "print(\"Generating 5-Fold OOF training representations...\")\n",
    "n_train = len(train_df)\n",
    "X_train_oof = np.zeros((n_train, 4), dtype=np.float64)\n",
    "y_train = train_df[\"target_blue_win\"].astype(int).values\n",
    "\n",
    "# Deterministic 5-fold modulo partition\n",
    "for fold_k in range(5):\n",
    "    val_mask = np.array([(i % 5 == fold_k) for i in range(n_train)])\n",
    "    fold_tables = build_relational_lookup_tables(train_df[~val_mask])\n",
    "    for orig_idx in np.where(val_mask)[0]:\n",
    "        X_train_oof[orig_idx] = extract_match_relational_features(train_df.iloc[orig_idx], fold_tables)\n",
    "\n",
    "print(\"Generating held-out test representations from 100% frozen train tables...\")\n",
    "full_train_tables = build_relational_lookup_tables(train_df)\n",
    "X_test = np.array([extract_match_relational_features(test_df.iloc[i], full_train_tables) for i in range(len(test_df))])\n",
    "y_test = test_df[\"target_blue_win\"].astype(int).values\n",
    "\n",
    "# One-hot matrices\n",
    "X_train_oh = np.array([extract_onehot_vector(r) for _, r in train_df.iterrows()])\n",
    "X_test_oh  = np.array([extract_onehot_vector(r) for _, r in test_df.iterrows()])\n",
    "\n",
    "print(f\"OOF Training Features Shape: {X_train_oof.shape}\")\n",
    "print(f\"Held-Out Test Features Shape: {X_test.shape}\")\n",
    "print(f\"One-Hot Matrices Shape     : Train {X_train_oh.shape}, Test {X_test_oh.shape}\")"
   ]
  },
