    "## 3. Evaluation Metrics Helper Functions\n",
    "\n",
    "ฟังก์ชันคำนวณสถิติและตัวชี้วัดประสิทธิภาพตามมาตรฐานของเปเปอร์:\n",
    "- **Wilson 95% Score Confidence Interval:** $[p_{\\text{low}}, p_{\\text{high}}]$\n",
    "- **Balanced Accuracy, Brier Score, ROC-AUC**\n",
    "- **McNemar's Paired Test with Continuity Correction:** $\\chi^2 = \\frac{(|b - c| - 1)^2}{b + c}$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =====================================================================\n",
    "# Statistical Evaluation Helpers\n",
    "# =====================================================================\n",
    "def compute_wilson_ci(correct, n, z=1.95996):\n",
    "    if n == 0: return 0.0, 0.0\n",
    "    p = correct / n\n",
    "    denom = 1.0 + z * z / n\n",
    "    center = (p + z * z / (2.0 * n)) / denom\n",
    "    half = z * sqrt(p * (1.0 - p) / n + z * z / (4.0 * n * n)) / denom\n",
    "    return max(0.0, center - half) * 100.0, min(1.0, center + half) * 100.0\n",
    "\n",
    "def evaluate_predictions(y_true, y_pred, y_prob=None):\n",
    "    correct = int((y_pred == y_true).sum())\n",
    "    n = len(y_true)\n",
    "    acc = correct / n * 100.0\n",
    "    ci_lo, ci_hi = compute_wilson_ci(correct, n)\n",
    "    bal_acc = balanced_accuracy_score(y_true, y_pred) * 100.0\n",
    "    brier = brier_score_loss(y_true, y_prob) if y_prob is not None else np.nan\n",
    "    auc = roc_auc_score(y_true, y_prob) if y_prob is not None else np.nan\n",
    "    return {\n",
    "        \"correct\": correct,\n",
    "        \"n\": n,\n",
    "        \"accuracy\": acc,\n",
    "        \"ci_str\": f\"[{ci_lo:.2f}%, {ci_hi:.2f}%]\",\n",
    "        \"bal_acc\": bal_acc,\n",
    "        \"brier\": brier,\n",
    "        \"auc\": auc\n",
    "    }\n",
    "\n",
    "print(\"Evaluation helpers defined successfully.\")"
   ]
