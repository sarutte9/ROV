    "# Step 5: Reproduce Table 4 (Selective Decisional Margins)\n",
    "# =====================================================================\n",
    "margins = np.abs(prob_gbdt - 0.5)\n",
    "sorted_indices = np.argsort(margins)[::-1]  # เรียงจากความมั่นใจสูงสุดลงมา\n",
    "\n",
    "table4_tiers = [\n",
    "    (\"Full Test Set\", 1.00),\n",
    "    (\"Top 50% Margin\", 0.50),\n",
    "    (\"Top 30% Margin\", 0.30),\n",
    "    (\"Top 20% Margin\", 0.20),\n",
    "    (\"Top 15% Margin\", 0.15),\n",
    "    (\"Top 10% Margin\", 0.10),\n",
    "]\n",
    "\n",
    "table4_rows = []\n",
    "for tier_name, tier_ratio in table4_tiers:\n",
    "    count = int(round(len(y_test) * tier_ratio))\n",
    "    sub_idx = sorted_indices[:count]\n",
    "    sub_y = y_test[sub_idx]\n",
    "    sub_pred = p_gbdt[sub_idx]\n",
    "    sub_prob = prob_gbdt[sub_idx]\n",
    "    res = evaluate_predictions(sub_y, sub_pred, sub_prob)\n",
    "    table4_rows.append({\n",
    "        \"Coverage Tier\": tier_name,\n",
    "        \"Games\": count,\n",
    "        \"Coverage\": f\"{tier_ratio * 100:.1f}%\":\n",
    "        \"Correct\": f\"{res['correct']} / {count}\",\n",
    "        \"Conditional Accuracy\": f\"{res['accuracy']:.2f}%\",\n",
    "        \"95% CI\": res[\"ci_str\"]\n",
    "    })\n",
    "\n",
    "table4_df = pd.DataFrame(table4_rows)\n",
    "print(\"\\n--- Table 4: Conditional Accuracy Under Selective Decision Margins (N = 1,148) ---\")\n",
    "display(table4_df)\n",
    "\n",
    "# Two-proportion z-test: Top 10% vs Remaining 90%\n",
    "n_top10 = int(round(len(y_test) * 0.10))\n",
    "top10_corr = int((p_gbdt[sorted_indices[:n_top10]] == y_test[sorted_indices[:n_top10]]).sum())\n",
    "rem90_corr = int((p_gbdt[sorted_indices[n_top10:]] == y_test[sorted_indices[n_top10:]]).sum())\n",
    "n_rem90 = len(y_test) - n_top10\n",
    "\n",
    "p1 = top10_corr / n_top10\n",
    "p2 = rem90_corr / n_rem90\n",
    "p_pooled = (top10_corr + rem90_corr) / len(y_test)\n",
    "se = sqrt(p_pooled * (1.0 - p_pooled) * (1.0 / n_top10 + 1.0 / n_rem90))\n",
    "z_val = (p1 - p2) / se\n",
    "p_val_z = 2.0 * (1.0 - stats.norm.cdf(abs(z_val)))\n",
    "\n",
    "print(f\"\\nTwo-Proportion z-test (Top 10% vs Remaining 90%):\")\n",
    "print(f\"  Top 10% Accuracy      : {top10_corr}/{n_top10} ({p1*100:.2f}%)\")\n",
    "print(f\"  Remaining 90% Accuracy: {rem90_corr}/{n_rem90} ({p2*100:.2f}%)\")\n",
    "print(f\"  z-statistic = {z_val:.2f},  two-tailed p-value = {p_val_z:.3f} (Significant at alpha = 0.05)\")"
   ]
