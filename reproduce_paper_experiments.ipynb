    "# =====================================================================\n",
    "# Statistical Verification: McNemar's Paired Tests\n",
    "# =====================================================================\n",
    "def run_mcnemar_test(pred_a, pred_b, y_true, label_a, label_b):\n",
    "    corr_a = (pred_a == y_true)\n",
    "    corr_b = (pred_b == y_true)\n",
    "    b = int((corr_a & ~corr_b).sum())\n",
    "    c = int((~corr_a & corr_b).sum())\n",
    "    diff = abs(b - c)\n",
    "    chi2 = (diff - 1)**2 / (b + c) if (b + c) > 0 else 0.0\n",
    "    p_val = 1.0 - stats.chi2.cdf(chi2, df=1)\n",
    "    print(f\"\\nMcNemar Test: {label_a} vs {label_b}\")\n",
    "    print(f\"  b ({label_a} Correct, {label_b} Wrong) = {b}\")\n",
    "    print(f\"  c ({label_b} Correct, {label_a} Wrong) = {c}\")\n",
    "    print(f\"  |b - c| = {diff},  b + c = {b + c}\")\n",
    "    print(f\"  Formula: (|{diff}| - 1)^2 / {b + c} = {diff - 1}^2 / {b + c} = {(diff - 1)**2} / {b + c}\")\n",
    "    print(f\"  chi2 = {chi2:.4f},  p-value = {p_val:.4f}\")\n",
    "    return b, c, chi2, p_val\n",
    "\n",
    "# Test 1: Relational LR vs One-Hot LR\n",
    "b1, c1, chi1, p1 = run_mcnemar_test(p_rel_lr, p_oh, y_test, \"Relational LR\", \"One-Hot LR\")\n",
    "\n",
    "# Test 2: GBDT vs Always Blue Baseline\n",
    "b2, c2, chi2, p2 = run_mcnemar_test(p_gbdt, p_blue, y_test, \"GBDT\", \"Always Blue\")"
   ]
